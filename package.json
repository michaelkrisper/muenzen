{
  "name": "muenzen",
  "version": "1.0.0",
  "description": "Count euro coins from a photo: number and total value, as an installable web app right in the browser",
  "homepage": "https://michaelkrisper.github.io/muenzen/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelkrisper/muenzen.git"
  },
  "bugs": "https://github.com/michaelkrisper/muenzen/issues",
  "author": "Michael Krisper",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/browser-check.mjs tests/fixtures/coins.jpg 20 1106",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4"
  }
}
